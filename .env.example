# Public browser configuration. Do not commit service-role keys or provider secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# The MVP defaults to OpenStreetMap tiles and does not require a map API key.
# For production traffic, configure a tile provider with an SLA and keep its
# attribution visible.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional: browse the public map and curated catalog without signing in.
# Saving, community data and personalized backend suggestions are disabled.
VITE_DEMO_MODE=false

# Server-side function secrets (configure in Supabase, never expose as VITE_):
# GOOGLE_PLACES_API_KEY=
# CATALOG_IMPORT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=managed-by-supabase
