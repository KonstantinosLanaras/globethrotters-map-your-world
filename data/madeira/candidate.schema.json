{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globethrotters.example/schemas/madeira-candidate.schema.json",
  "title": "Globetrotters editorial candidate",
  "type": "object",
  "required": [
    "candidate_id", "name", "content_kind", "category", "subcategory",
    "description", "audience_fit", "essentiality", "local_distinctiveness",
    "activity_quality", "value_accessibility", "social_potential",
    "suitable_traveller_types", "budget_level", "typical_duration",
    "best_season_time", "locality", "existence_confidence",
    "coordinates", "source_checks", "verification_status"
  ],
  "properties": {
    "candidate_id": {"type":"string","minLength":1},
    "name": {"type":"string","minLength":1},
    "content_kind": {"enum":["place","route","area","timed_experience"]},
    "category": {"enum":["food","culture","nature","nightlife"]},
    "subcategory": {"type":"string","minLength":1},
    "description": {"type":"string","minLength":1},
    "audience_fit": {"$ref":"#/$defs/scored"},
    "essentiality": {"$ref":"#/$defs/scored"},
    "local_distinctiveness": {"$ref":"#/$defs/scored"},
    "activity_quality": {"$ref":"#/$defs/scored"},
    "value_accessibility": {"$ref":"#/$defs/scored"},
    "social_potential": {"$ref":"#/$defs/scored"},
    "suitable_traveller_types": {"type":"array","items":{"enum":["solo","couple","friends"]},"uniqueItems":true},
    "budget_level": {"enum":["free","low","moderate","high","varies","unknown"]},
    "typical_duration": {"type":["string","null"]},
    "best_season_time": {"type":["string","null"]},
    "locality": {"type":["string","null"]},
    "existence_confidence": {"type":"number","minimum":0,"maximum":1},
    "coordinates": {"type":["object","null"],"properties":{"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180}},"required":["latitude","longitude"],"additionalProperties":false},
    "source_checks": {"type":"array","items":{"type":"object","required":["source","status"],"properties":{"source":{"type":"string"},"status":{"enum":["matched","ambiguous","unmatched","not_checked","not_applicable"]},"source_id":{"type":["string","null"]},"method":{"type":["string","null"]},"distance_m":{"type":["number","null"]},"checked_at":{"type":["string","null"],"format":"date-time"},"url":{"type":["string","null"],"format":"uri"},"rationale":{"type":["string","null"]}},"additionalProperties":false}},
    "verification_status": {"enum":["unverified_candidate","source_review","editorial_approved","rejected"]},
    "safety_access_flags": {"type":"array","items":{"type":"string"}},
    "related_candidate_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true}
  },
  "$defs": {"scored":{"type":"object","required":["score","rationale"],"properties":{"score":{"type":"integer","minimum":0,"maximum":5},"rationale":{"type":"string","minLength":1}},"additionalProperties":false}},
  "additionalProperties": false
}
